# =============================================================================
# EchoText Configuration (.env.example)
# Copy this file to .env and fill in your values. Never commit .env to git!
# =============================================================================

# --- 1. Telegram Userbot Credentials (get from https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- 2. Dashboard Authentication (Localhost 127.0.0.1) ---
# Generate a PBKDF2-SHA256 hash via:
#   python -c "from auth import hash_password; print(hash_password('your_strong_pass'))"
# and set ECHOTEXT_DASHBOARD_PASSWORD_HASH (or set ECHOTEXT_DASHBOARD_PASSWORD):
ECHOTEXT_DASHBOARD_PASSWORD=
ECHOTEXT_DASHBOARD_PASSWORD_HASH=
ECHOTEXT_LOCKOUT_ATTEMPTS=5
ECHOTEXT_LOCKOUT_SECONDS=300
ECHOTEXT_SESSION_TIMEOUT_SECONDS=1800

# --- 3. Hardware & Model Profile (pc_3b | pc_8b | phone_3b) ---
ECHOTEXT_HARDWARE_PROFILE=pc_3b
# Optional explicit path to your local GGUF model:
# ECHOTEXT_MODEL_PATH=models/Llama-3.2-3B-Instruct.Q4_K_M.gguf
ECHOTEXT_GPU_LAYERS=0

# --- 4. Owner Persona, Timezone & Safety Defaults ---
ECHOTEXT_OWNER_NAME=Abhay
ECHOTEXT_TIMEZONE=Asia/Kolkata
ECHOTEXT_FOOTER_TEXT=— sent by Abhay's assistant
ECHOTEXT_SENSITIVITY_THRESHOLD=2
ECHOTEXT_MAX_REPLIES_PER_HOUR=5
ECHOTEXT_COOLDOWN_SECONDS=60
ECHOTEXT_KILL_SWITCH_HOURS=2.0
ECHOTEXT_AUTO_SEND_DELAY_SECONDS=10
ECHOTEXT_NUM_DRAFT_OPTIONS=3

# --- 5. Active Hours & Privacy Retention ---
ECHOTEXT_ACTIVE_HOURS_ENABLED=false
ECHOTEXT_ACTIVE_HOURS_START=8
ECHOTEXT_ACTIVE_HOURS_END=23
ECHOTEXT_RETENTION_DAYS=30
ECHOTEXT_HIDE_MESSAGE_TEXT=true

# --- 6. Local API Key (auto-generated in logs/.echotext_api_key if left blank) ---
ECHOTEXT_API_KEY=

# --- 7. Optional Private Phone Approval Bot (reached over Tailscale) ---
ECHOTEXT_APPROVAL_BOT_TOKEN=
ECHOTEXT_OWNER_TELEGRAM_ID=

# --- 8. Optional Offline Voice-Note Transcription (whisper.cpp / faster-whisper) ---
ECHOTEXT_WHISPER_BIN=whisper-cli
ECHOTEXT_WHISPER_MODEL_PATH=models/ggml-base.bin
